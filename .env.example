# OmniBCI Discovery Lab - Environment Variables Template
# Copy this file to .env and fill in your keys (DO NOT commit .env to GitHub)

# Anthropic API Key (Required for live Claude 3.5 Sonnet / Haiku calls; simulated fallback if omitted)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ElevenLabs API Key (Optional: for generating 2-minute video demo narration)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# BrightData API Key (Optional: for live web scraping of external papers & repositories)
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Databricks Omnigent Workspace (Optional: if connecting to managed Databricks cloud sandbox)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
